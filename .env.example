# Environment Configuration Example
# Copy this file to .env on your production server:
# cp .env.example .env

# Application Environment (production / development)
APP_ENV=production

# Backend Server Host & Port (Internal listening address)
HOST=0.0.0.0
PORT=8000

# Your DuckDNS Domain (e.g., myhabits.duckdns.org)
APP_DOMAIN=yoursubdomain.duckdns.org

# Frontend API Base URL (default is same-origin /api)
VITE_API_BASE_URL=/api
API_BASE_URL=/api

# Allowed CORS Origins (if backend and frontend ever communicate across domains)
ALLOWED_ORIGINS=https://yoursubdomain.duckdns.org
