# Environment Configuration Example
# Copy this file to .env on your production server:
# cp .env.example .env

# Application Environment (production / development)
APP_ENV=production

# Backend Server Host & Port (Internal listening address)
HOST=0.0.0.0
PORT=8000

# Your DuckDNS Domain (e.g., myhabits.duckdns.org)
APP_DOMAIN=yoursubdomain.duckdns.org

# Frontend API Base URL (default is same-origin /api)
VITE_API_BASE_URL=/api
API_BASE_URL=/api

# Allowed CORS Origins (if backend and frontend ever communicate across domains)
ALLOWED_ORIGINS=https://yoursubdomain.duckdns.org

# --- Firebase cloud sync (optional) -----------------------------------------
# Leave these empty/unset to run the app local-only. See FIREBASE_SETUP.md.
# Baked into the build. Production values live in the committed .env.production;
# use a git-ignored .env.local for local development.
# These values are not secrets; access is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
